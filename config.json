{
  "excluded_extensions": [
    ".lnk",
    ".url"
  ],
  "max_file_size_mb": 100,
  "include_folders_in_organize": false,
  "include_folders_in_backup": true,
  "categories": {
    "📄 文档": {
      "extensions": [
        ".txt",
        ".doc",
        ".docx",
        ".pdf",
        ".xls",
        ".xlsx",
        ".ppt",
        ".pptx",
        ".md",
        ".csv",
        ".rtf",
        ".odt"
      ],
      "icon": "📄"
    },
    "🖼️ 图片": {
      "extensions": [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".bmp",
        ".svg",
        ".ico",
        ".webp",
        ".heic"
      ],
      "icon": "🖼️"
    },
    "🎬 视频": {
      "extensions": [
        ".mp4",
        ".avi",
        ".mkv",
        ".mov",
        ".wmv",
        ".flv",
        ".webm"
      ],
      "icon": "🎬"
    },
    "🎵 音频": {
      "extensions": [
        ".mp3",
        ".wav",
        ".flac",
        ".aac",
        ".ogg",
        ".wma",
        ".m4a"
      ],
      "icon": "🎵"
    },
    "📦 压缩包": {
      "extensions": [
        ".zip",
        ".rar",
        ".7z",
        ".tar",
        ".gz",
        ".tar.gz"
      ],
      "icon": "📦"
    },
    "💻 程序": {
      "extensions": [
        ".exe",
        ".msi",
        ".deb",
        ".dmg"
      ],
      "icon": "💻"
    },
    "📂 桌面文件夹": {
      "extensions": [
        "__FOLDER__"
      ],
      "icon": "📂"
    },
    "📁 其他": {
      "extensions": [],
      "icon": "📁"
    }
  }
}
